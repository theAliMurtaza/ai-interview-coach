# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
APP_NAME=Console API
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-generated-random-secret
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["localhost","127.0.0.1"]
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Optional public Google OAuth Web client ID; see ../GOOGLE_SIGN_IN.md.
GOOGLE_OAUTH_CLIENT_ID=
# Use a hexadecimal password here so it is safe to interpolate into Compose connection URLs.
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
DATABASE_URL=postgresql+asyncpg://console:replace-with-a-generated-hex-password@localhost:5432/console
DATABASE_URL_SYNC=postgresql+psycopg2://console:replace-with-a-generated-hex-password@localhost:5432/console
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=300
# Explicit offline mode: seed questions, deterministic grading, keyword parsing/search/matching.
AI_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=
STT_PROVIDER=openai_whisper
TTS_PROVIDER=openai
# Local storage is for development; staging/production require private S3-compatible storage.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=console-uploads
STORAGE_REGION=us-east-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
BILLING_RETURN_URL=http://localhost:5173/billing
N8N_WEBHOOK_SECRET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
