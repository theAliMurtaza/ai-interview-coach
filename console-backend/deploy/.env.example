# Enter these in Render's Environment settings; never commit real values.
APP_ENV=production
DEBUG=false
# Blueprint generates SECRET_KEY automatically. Keep it stable across redeploys.
SECRET_KEY=replace-with-a-generated-random-secret
# Copy Neon's DIRECT connection string (Pooler disabled) into both variables.
# Plain postgresql:// URLs are supported, including URL-encoded passwords.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=3
# Upstash TCP/TLS Redis URL, NOT its REST HTTPS URL or REST token.
REDIS_URL=rediss://default:PASSWORD@YOUR-HOST.upstash.io:6379
RATE_LIMIT_ENABLED=true
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Render's RENDER_EXTERNAL_HOSTNAME is added automatically. Add custom API hosts above.
BACKEND_CORS_ORIGINS=["https://YOUR-FRONTEND.vercel.app"]
# Optional: Google OAuth Web client ID. Authorize the frontend origin in Google.
GOOGLE_OAUTH_CLIENT_ID=
STORAGE_BACKEND=s3
STORAGE_ENDPOINT_URL=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=YOUR-R2-ACCESS-KEY
STORAGE_SECRET_ACCESS_KEY=YOUR-R2-SECRET-KEY
STORAGE_BUCKET_NAME=interview-coach-uploads
STORAGE_REGION=auto
MAX_UPLOAD_BYTES=10485760
AI_ENABLED=false
